# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_budget?schema=public"

# Database URL for running integration tests
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/family_budget_test?schema=public"

# Secret key used for signing HTTP-only session cookies
# Must be at least 32 characters in production
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"
SESSION_COOKIE_NAME="fb_session"
APP_ORIGIN="http://localhost:3000"

# Application Environment (development, production, test)
NODE_ENV="development"

# ─── AI / Claude ───────────────────────────────────────────────────────────
# Master kill switch. Set to "false" to disable all AI features globally.
# AI is OFF by default for every new family (aiEnabled: false in DB).
AI_ENABLED="true"

# Your Anthropic API key (obtain from console.anthropic.com).
# Leave blank to run without AI — all AI features degrade gracefully.
# In production create a key with a monthly spend cap on the Anthropic console.
ANTHROPIC_API_KEY=""

# Model IDs — override only if you have access to newer versions.
# Fast model: used for categorisation, text parse, bank-message import.
AI_MODEL_FAST="claude-haiku-4-5-20251001"
# Vision model: used for receipt OCR.
AI_MODEL_VISION="claude-sonnet-5-5"
# Coach / reasoning model: used for the AI coach and scenario explanations.
AI_MODEL_COACH="claude-sonnet-5-5"

# Monthly cost cap per family in micros (1 micro = 0.000001 USD).
# Default 5 000 000 ≈ $5 USD / family / month.
# Override to raise or lower the cap for all new families (existing families
# keep their DB-stored cap until updated via the settings UI).
AI_MONTHLY_CAP_MICROS="5000000"

# Per-user AI rate limit: max calls per 10-minute window.
AI_RATE_LIMIT_CALLS="20"
AI_RATE_LIMIT_WINDOW_MS="600000"
