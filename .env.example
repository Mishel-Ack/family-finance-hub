# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_budget?schema=public"

# Database URL for running integration tests
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/family_budget_test?schema=public"

# Secret key used for signing HTTP-only session cookies
# Must be at least 32 characters in production
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"
SESSION_COOKIE_NAME="fb_session"
APP_ORIGIN="http://localhost:3000"

# Application Environment (development, production, test)
NODE_ENV="development"
