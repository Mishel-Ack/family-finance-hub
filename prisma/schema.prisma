datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InviteRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ExpenseVisibility {
  SHARED
  PRIVATE
}

enum SplitMode {
  EQUAL
  EXACT
  PERCENT
}

enum ActivityType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  BUDGET_UPSERTED
  BUDGET_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_ARCHIVED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  OWNERSHIP_TRANSFERRED
  INVITE_CREATED
  INVITE_REVOKED
  SPLIT_CREATED
  SPLIT_REMOVED
  SETTLEMENT_RECORDED
  SETTLEMENT_DELETED
}

enum ActivityEntityType {
  EXPENSE
  BUDGET
  CATEGORY
  MEMBER
  FAMILY
  INVITE
  SPLIT
  SETTLEMENT
}

enum AiUsageFeature {
  CATEGORIZATION
  EXPENSE_TEXT
  RECEIPT
  BANK_MESSAGES
  COACH
  SCENARIO_EXPLANATION
  REPORT_NARRATIVE
}

enum AiUsageOutcome {
  OK
  INVALID_OUTPUT
  ERROR
  BLOCKED
}

enum CorrectionScope {
  SHARED
  PRIVATE
}

enum InsightType {
  MID_MONTH_OVERSPEND
  CATEGORY_ANOMALY
  DUPLICATE_CHARGE
  RECURRING_BILL
  PRICE_INCREASE
  FORECAST
  FINANCIAL_HEALTH
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
}

enum InsightVerdict {
  USEFUL
  NOT_USEFUL
  DISMISS
}

model User {
  id                String               @id @default(uuid())
  name              String
  email             String               @unique
  passwordHash      String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  families          Family[]             @relation("FamilyOwner")
  memberships       FamilyMember[]
  expenses          Expense[]
  usedInvites       Invite[]
  aiUsage           AiUsage[]
  corrections       CategoryCorrection[]
  dismissedInsights Insight[]            @relation("InsightDismissedBy")
  insightFeedback   InsightFeedback[]
  createdFunds      SinkingFund[]
  createdGoals      Goal[]
  fundContributions FundContribution[]
}

model Family {
  id                 String               @id @default(uuid())
  name               String
  ownerId            String
  owner              User                 @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  members            FamilyMember[]
  categories         Category[]
  budgets            Budget[]
  expenses           Expense[]
  invites            Invite[]
  activity           ActivityLog[]
  settlements        Settlement[]
  aiEnabled          Boolean              @default(false)
  aiMonthlyCapMicros Int                  @default(5000000)
  aiUsage            AiUsage[]
  corrections        CategoryCorrection[]
  importFingerprints ImportFingerprint[]
  insights           Insight[]
  incomeProfile      IncomeProfile?
  sinkingFunds       SinkingFund[]
  goals              Goal[]
  fundContributions  FundContribution[]

  @@index([ownerId])
}

model AiUsage {
  id                  String         @id @default(uuid())
  familyId            String
  family              Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature             AiUsageFeature
  model               String
  inputTokens         Int
  outputTokens        Int
  estimatedCostMicros Int
  latencyMs           Int
  outcome             AiUsageOutcome
  createdAt           DateTime       @default(now())

  @@index([familyId, createdAt])
}

model CategoryCorrection {
  id          String          @id @default(uuid())
  familyId    String
  userId      String
  merchantKey String
  categoryId  String
  scope       CorrectionScope
  createdAt   DateTime        @default(now())
  family      Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([familyId, userId, merchantKey, scope])
  @@index([familyId, merchantKey, scope])
}

model ImportFingerprint {
  id        String   @id @default(uuid())
  familyId  String
  hash      String
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, hash])
  @@index([familyId, createdAt])
}

model Insight {
  id                String            @id @default(uuid())
  familyId          String
  type              InsightType
  key               String
  payload           Json
  severity          InsightSeverity
  computedAt        DateTime          @default(now())
  dismissedAt       DateTime?
  dismissedByUserId String?
  family            Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  dismissedBy       User?             @relation("InsightDismissedBy", fields: [dismissedByUserId], references: [id], onDelete: SetNull)
  feedback          InsightFeedback[]

  @@unique([familyId, type, key])
  @@index([familyId, dismissedAt, computedAt])
}

model IncomeProfile {
  id                 String   @id @default(uuid())
  familyId           String   @unique
  monthlyIncomePaise Int
  updatedAt          DateTime @updatedAt
  family             Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model InsightFeedback {
  id        String         @id @default(uuid())
  insightId String
  userId    String
  verdict   InsightVerdict
  createdAt DateTime       @default(now())
  insight   Insight        @relation(fields: [insightId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([insightId, userId])
  @@index([userId, createdAt])
}

model SinkingFund {
  id                String             @id @default(uuid())
  familyId          String
  name              String
  targetPaise       Int
  dueDate           DateTime
  categoryId        String?
  createdByMemberId String?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdByMember   FamilyMember?      @relation(fields: [createdByMemberId], references: [id], onDelete: SetNull)
  contributions     FundContribution[]
  User              User?              @relation(fields: [userId], references: [id])
  userId            String?

  @@index([familyId, archivedAt, dueDate])
}

model FundContribution {
  id          String        @id @default(uuid())
  familyId    String
  fundId      String
  memberId    String?
  amountPaise Int
  createdAt   DateTime      @default(now())
  family      Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fund        SinkingFund   @relation(fields: [fundId], references: [id], onDelete: Cascade)
  member      FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  User        User?         @relation(fields: [userId], references: [id])
  userId      String?

  @@index([familyId, fundId, createdAt])
}

model Goal {
  id                String        @id @default(uuid())
  familyId          String
  name              String
  targetPaise       Int
  targetDate        DateTime
  createdByMemberId String?
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  family            Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByMember   FamilyMember? @relation(fields: [createdByMemberId], references: [id], onDelete: SetNull)
  User              User?         @relation(fields: [userId], references: [id])
  userId            String?

  @@index([familyId, archivedAt, targetDate])
}

model FamilyMember {
  id                 String             @id @default(uuid())
  familyId           String
  family             Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String             @default("")
  role               Role               @default(MEMBER)
  createdAt          DateTime           @default(now())
  expenses           Expense[]
  createdInvites     Invite[]
  activities         ActivityLog[]
  formerAt           DateTime?
  expenseSplits      ExpenseSplit[]
  settlementsFrom    Settlement[]       @relation("SettlementFrom")
  settlementsTo      Settlement[]       @relation("SettlementTo")
  settlementsCreated Settlement[]       @relation("SettlementCreator")
  createdFunds       SinkingFund[]
  createdGoals       Goal[]
  fundContributions  FundContribution[]

  @@unique([familyId, userId])
  @@unique([userId])
  @@index([familyId])
}

model Invite {
  id                           String        @id @default(uuid())
  familyId                     String
  family                       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByMemberId            String?
  createdByMember              FamilyMember? @relation(fields: [createdByMemberId], references: [id], onDelete: SetNull)
  createdByDisplayNameSnapshot String        @default("")
  role                         InviteRole
  tokenHash                    String        @unique
  email                        String?
  expiresAt                    DateTime
  usedAt                       DateTime?
  usedByUserId                 String?
  usedByUser                   User?         @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)
  revokedAt                    DateTime?
  createdAt                    DateTime      @default(now())

  @@index([familyId, revokedAt, usedAt, expiresAt])
}

model Category {
  id               String               @id @default(uuid())
  familyId         String
  family           Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name             String
  color            String               @default("#6b7280")
  icon             String               @default("Tag")
  isDefault        Boolean              @default(false)
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  budgetCategories BudgetCategory[]
  expenses         Expense[]
  corrections      CategoryCorrection[]
  sinkingFunds     SinkingFund[]

  @@unique([familyId, name])
  @@index([familyId])
  @@index([familyId, archivedAt])
}

model Budget {
  id              String           @id @default(uuid())
  familyId        String
  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  totalLimitPaise Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  categories      BudgetCategory[]

  @@unique([familyId, month, year])
  @@index([familyId])
}

model BudgetCategory {
  id               String   @id @default(uuid())
  budgetId         String
  budget           Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  limitAmountPaise Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([budgetId, categoryId])
  @@index([budgetId])
}

model Expense {
  id                 String            @id @default(uuid())
  familyId           String
  family             Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId           String?
  member             FamilyMember?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberNameSnapshot String?
  memberIdSnapshot   String?
  visibility         ExpenseVisibility @default(SHARED)
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amountPaise        Int
  date               DateTime          @default(now())
  description        String            @default("")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  splits             ExpenseSplit[]

  @@index([familyId, date])
  @@index([familyId, categoryId])
  @@index([familyId, memberId, date])
  @@index([familyId, visibility, date])
  @@index([memberId])
}

model ExpenseSplit {
  id          String       @id @default(uuid())
  expenseId   String
  expense     Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId    String
  member      FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sharePaise  Int
  mode        SplitMode    @default(EXACT)
  basisPoints Int?

  @@unique([expenseId, memberId])
  @@index([memberId])
}

model Settlement {
  id                String        @id @default(uuid())
  familyId          String
  family            Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromMemberId      String
  fromMember        FamilyMember  @relation("SettlementFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMemberId        String
  toMember          FamilyMember  @relation("SettlementTo", fields: [toMemberId], references: [id], onDelete: Restrict)
  fromNameSnapshot  String
  toNameSnapshot    String
  amountPaise       Int
  note              String        @default("") @db.VarChar(200)
  createdByMemberId String?
  createdByMember   FamilyMember? @relation("SettlementCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())

  @@index([familyId, createdAt])
}

model ActivityLog {
  id                String             @id @default(uuid())
  familyId          String
  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actorMemberId     String?
  actorMember       FamilyMember?      @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  actorNameSnapshot String
  type              ActivityType
  entityType        ActivityEntityType
  entityId          String?
  summary           Json
  createdAt         DateTime           @default(now())

  @@index([familyId, createdAt, id])
  @@index([familyId, entityType, entityId])
}
